{
  "name": "fast-vite-nestjs-electron",
  "version": "0.0.1",
  "packageManager": "pnpm@9.1.1",
  "description": "Vite + Electron with Doubleshot, so fast! ⚡",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "rimraf dist && vite",
    "debug": "rimraf dist && vite -- --dsb-debug",
    "build": "rimraf dist && vue-tsc && vite build",
    "postinstall": "electron-builder install-app-deps ",
    "migrate": "prisma migrate dev  --skip-seed",
    "postmigrate": "npx @snaplet/seed sync && prisma db seed",
    "type-check": "vue-tsc --noEmit",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx ./src/main/prisma/seed/seed.ts",
    "schema": "./src/main/prisma/schema.prisma"
  },
  "dependencies": {
    "@fontsource/tajawal": "^5.0.13",
    "@nestjs/common": "^10.3.10",
    "@nestjs/core": "^10.3.10",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.3.10",
    "@prisma/client": "^5.17.0",
    "@tanstack/vue-query": "^5.49.1",
    "@tanstack/vue-query-devtools": "^5.49.1",
    "@vee-validate/zod": "^4.13.1",
    "@vueuse/core": "^10.11.0",
    "@vueuse/integrations": "^10.11.0",
    "argon2": "^0.40.3",
    "axios": "^1.7.2",
    "decimal.js": "^10.4.3",
    "luxon": "^3.4.4",
    "primevue": "3.52.0",
    "qs": "^6.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "vee-validate": "^4.13.1",
    "vue": "^3.4.31",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.0",
    "@eslint/js": "^9.6.0",
    "@faker-js/faker": "^8.4.1",
    "@iconify/json": "^2.2.225",
    "@snaplet/copycat": "^5.0.0",
    "@snaplet/seed": "0.97.20",
    "@tanstack/eslint-plugin-query": "^5.50.0",
    "@types/luxon": "^3.4.2",
    "@types/qs": "^6.9.15",
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/compiler-sfc": "3.4.27",
    "autoprefixer": "^10.4.19",
    "electron": "30.0.6",
    "electron-builder": "24.13.3",
    "eslint": "9.x",
    "eslint-plugin-vue": "^9.21.0",
    "globals": "^15.8.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "postcss": "^8.4.39",
    "prettier": "3.3.2",
    "prisma": "^5.17.0",
    "prisma-json-types-generator": "^3.0.4",
    "rimraf": "5.0.7",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "5.4.5",
    "typescript-eslint": "^7.15.0",
    "unplugin-icons": "^0.19.0",
    "unplugin-vue-components": "^0.27.2",
    "unplugin-vue-router": "^0.8.8",
    "vite": "5.2.11",
    "vite-plugin-doubleshot": "0.0.14",
    "vue-tsc": "2.0.19"
  },
  "@snaplet/seed": {
    "config": "src/main/prisma/seed/seed.config.ts"
  },
  "lint-staged": {
    "*.{ts,css,vue}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
