// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
  // namespace = "PrismaJson"
  // clientOutput = "<finds it automatically>"
  // (./ -> relative to schema, or an importable path to require() it)
}

datasource db {
  provider = "mysql"
  url      = env("VITE_DATABASE_URL")
}

model Beneficiary {
  id                  Int                  @id @default(autoincrement())
  join_date           DateTime             @default(now())
  initial_visit_date  DateTime?
  days_between_visits Int?
  notes               String?              @db.Text
  people              Person[]
  BeneficiaryBenefit  BeneficiaryBenefit[]

  branch_id  Int
  Branch     Branch   @relation(fields: [branch_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("beneficiary")
}

model Person {
  id            Int        @id @default(autoincrement())
  name          String
  identity_card String?
  type          PersonType
  birthday      DateTime
  gender        GENDER?
  income        Decimal?   @db.Decimal(19, 4)
  currency_code String? // ISO code: "USD", "EGP", "JPY"
  Currency      MoneyUnit? @relation(fields: [currency_code], references: [code])
  address       String?
  phone         String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  sponsorship_case_id Int?             @db.TinyInt
  sponsorship         SponsorshipCase? @relation(fields: [sponsorship_case_id], references: [id])

  beneficiary_id Int
  Beneficiary    Beneficiary @relation(fields: [beneficiary_id], references: [id])

  branch_id Int
  Branch    Branch @relation(fields: [branch_id], references: [id])

  @@unique([identity_card, branch_id])
  @@map("person")
}

model Benefit {
  id                  Int         @id @default(autoincrement())
  beneficiaries_count Int         @default(0)
  type                BenefitType

  FinancialBenefit FinancialBenefit?
  Item             Item?

  visit_benefits       VisitBenefit[]
  beneficiary_benefits BeneficiaryBenefit[]

  branch_id Int
  branch    Branch @relation(fields: [branch_id], references: [id])

  @@map("benefit")
}

model FinancialBenefit {
  id Int @id @default(autoincrement())

  name          String
  amount        Decimal @db.Decimal(19, 4)
  currency_code String

  Currency MoneyUnit @relation(fields: [currency_code], references: [code])

  benefit_id Int     @unique()
  benefit    Benefit @relation(fields: [benefit_id], references: [id], onDelete: Cascade)

  @@map("financial_benefit")
}

model Item {
  id   Int    @id @default(autoincrement())
  name String
  qty  Int

  category_id Int
  category    Category @relation(fields: [category_id], references: [id])
  unit_id     Int
  unit        Unit     @relation(fields: [unit_id], references: [id])

  benefit_id Int          @unique()
  benefit    Benefit      @relation(fields: [benefit_id], references: [id], onDelete: Cascade)
  DonateItem DonateItem[]

  @@map("item")
}

model BeneficiaryBenefit {
  beneficiary_id Int
  beneficiary    Beneficiary @relation(fields: [beneficiary_id], references: [id])
  benefit_id     Int
  Benefit        Benefit     @relation(fields: [benefit_id], references: [id], onDelete: Cascade)

  item_unit_size UNIT_SIZE? // if not financial benefit
  item_value     Int? // if not financial benefit

  @@id([beneficiary_id, benefit_id])
  @@map("beneficiary_benefit")
}

model VisitBenefit {
  id         Int     @id @default(autoincrement())
  visit_id   Int
  visit      Visit   @relation(fields: [visit_id], references: [id])
  benefit_id Int
  Benefit    Benefit @relation(fields: [benefit_id], references: [id])

  unit_label_and_unit String
  unit_value          Decimal
  Transaction         Transaction?

  @@map("visit_benefit")
}

model Visit {
  id             Int            @id @default(autoincrement())
  beneficiary_id Int
  created_at     DateTime
  note           String?        @db.Text
  visit_benefits VisitBenefit[]
  branch_id      Int
  branch         Branch         @relation(fields: [branch_id], references: [id])

  @@map("visit")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  Item Item[]

  parent_category_id Int?
  parentCategory     Category?  @relation("CategoryHierarchy", fields: [parent_category_id], references: [id])
  categories         Category[] @relation("CategoryHierarchy")

  branch_id Int
  branch    Branch @relation(fields: [branch_id], references: [id])

  @@map("category")
}

model MoneyUnit {
  code String @id // ISO code: "USD", "EGP", "JPY"

  enName   String // English name: "US Dollar"
  arName   String? // Arabic name: "دولار أمريكي"
  symbolEn String? // "$", "E£"
  symbolAr String? // "ج.م", "ر.س"

  // Relations
  transactions      Transaction[]
  financialBenefits FinancialBenefit[]
  Person            Person[]

  @@map("money_unit")
}

model Unit {
  id              Int    @id @default(autoincrement())
  category_label  String
  label           String @unique()
  bg_unit_label   String
  bg_unit_abbr    String
  sm_unit_label   String
  sm_unit_abbr    String
  sm_to_bg_factor Int
  item            Item[]

  @@map("unit")
}

model SponsorshipCase {
  id        Int      @id @default(autoincrement()) @db.TinyInt
  name      String
  branch_id Int
  branch    Branch   @relation(fields: [branch_id], references: [id])
  persons   Person[]

  @@unique([name, branch_id])
  @@map("sponsorship_case")
}

model Organization {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  created_at DateTime?
  logo_url   String?
  branches   Branch[]

  userRoles UserRole[]
  roles     Role[]

  @@map("organization")
}

model Branch {
  id                 Int               @id @default(autoincrement())
  address            String?
  phone              String?
  name               String
  organization_id    Int
  scheduled_visits   Boolean           @default(false)
  Organization       Organization      @relation(fields: [organization_id], references: [id])
  lang               Lang
  beneficiaries      Beneficiary[]
  sponsorships_cases SponsorshipCase[]
  Visit              Visit[]
  Donate             Donate[]
  Transaction        Transaction[]
  CategoryItem       Category[]
  benefits           Benefit[]
  persons            Person[]
  userRoles          UserRole[]

  @@unique([name, organization_id])
  @@map("branch")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String
  password     String
  is_suspended Boolean    @default(false)
  lang         Lang
  notes        Note[]
  appRole      AppRole?
  userRoles    UserRole[]

  @@map("user")
}

model Role {
  id             Int           @id @default(autoincrement())
  name           String
  scope          RoleScope
  // Optional: use when each org wants its own custom roles
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  action          String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  id             Int          @id @default(autoincrement())
  userId         Int
  roleId         Int
  organizationId Int // always set (tenant boundary)
  branchId       Int? // NULL ⇒ org-wide role
  branchKey      Int          @default(-1) // for unique constraints when branchId is null
  user           User         @relation(fields: [userId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch?      @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, organizationId, branchKey])
}

model Donate {
  id          Int      @id @default(autoincrement())
  donor       String
  donor_phone String?
  created_at  DateTime @default(now())
  created_by  String

  branch_id    Int
  branch       Branch       @relation(fields: [branch_id], references: [id])
  transaction  Transaction?
  donate_items DonateItem[]

  @@map("donate")
}

model DonateItem {
  id              Int       @id @default(autoincrement())
  item_id         Int
  donate_id       Int
  unit_value      Int // The  stored small value
  user_unit_size  UNIT_SIZE // the unit that user select when he add item
  user_unit_value Int // the value that user typed when add item

  Donate Donate @relation(fields: [donate_id], references: [id], onDelete: Cascade)
  Item   Item   @relation(fields: [item_id], references: [id])

  @@map("donate_item")
}

model Transaction {
  id            Int             @id @default(autoincrement())
  created_at    DateTime        @default(now())
  created_by    String
  currency_code String
  amount        Decimal         @db.Decimal(19, 4)
  label         String?
  type          TransactionType

  Currency MoneyUnit @relation(fields: [currency_code], references: [code])

  branch_id Int
  branch    Branch @relation(fields: [branch_id], references: [id])

  donate_id          Int?          @unique
  donate             Donate?       @relation(fields: [donate_id], references: [id], onDelete: Cascade)
  visit_benefit_id   Int?          @unique
  visit_benefit_item VisitBenefit? @relation(fields: [visit_benefit_id], references: [id])

  @@map("transaction")
}

model Note {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  content    String
  branch_id  Int?

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  @@map("note")
}

enum Lang {
  ar
  en
}

enum TransactionType {
  DONATE
  EXPENSE
}

enum UNIT_SIZE {
  SM
  LG
}

enum GENDER {
  MALE
  FEMALE
}

enum PersonType {
  BENEFICIARY
  SPOUSE
  CHILD
}

enum BenefitType {
  FINANCIAL
  ITEM
}

enum RoleScope {
  ORGANIZATION
  BRANCH
}

enum AppRole {
  SUPER_ADMIN
  SUPPORT
}
