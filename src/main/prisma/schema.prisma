// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
  // namespace = "PrismaJson"
  // clientOutput = "<finds it automatically>"
  // (./ -> relative to schema, or an importable path to require() it)
}

datasource db {
  provider = "mysql"
  url      = env("VITE_DATABASE_URL")
}

model Beneficiary {
  id                  Int                  @id @default(autoincrement())
  join_date           DateTime             @default(now())
  initial_visit_date  DateTime?
  days_between_visits Int?
  notes               String?              @db.Text
  people              Person[]
  BeneficiaryBenefit  BeneficiaryBenefit[]

  branch_id  Int
  Branch     Branch?  @relation(fields: [branch_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("beneficiary")
}

model Person {
  id            Int         @id @default(autoincrement())
  name          String
  identity_card String?     @unique
  type          PersonType?
  birthday      DateTime
  gender        GENDER?
  income        Decimal?    @db.Decimal(10, 2)
  address       String?
  phone         String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  sponsorship_case_id Int?             @db.TinyInt
  sponsorship         SponsorshipCase? @relation(fields: [sponsorship_case_id], references: [id])

  beneficiary_id Int
  Beneficiary    Beneficiary @relation(fields: [beneficiary_id], references: [id])

  @@map("person")
}


model Benefit {
  id                  Int         @id @default(autoincrement())
  beneficiaries_count Int         @default(0)
  type                BenefitType

  FinancialBenefit FinancialBenefit?
  Item             Item?

  visit_benefits       VisitBenefit[]
  beneficiary_benefits BeneficiaryBenefit[]

  @@map("benefit")
}
model FinancialBenefit {
  id Int @id @default(autoincrement())

  name    String
  amount  Decimal   @db.Decimal(10, 2)
  unit_id Int
  unit    MoneyUnit @relation(fields: [unit_id], references: [id])

  benefit_id Int     @unique()
  benefit    Benefit @relation(fields: [benefit_id], references: [id],onDelete: Cascade)

  @@map("financial_benefit")
}

model Item {
  id   Int    @id @default(autoincrement())
  name String
  qty  Int

  category_id Int
  category    Category @relation(fields: [category_id], references: [id])
  unit_id     Int
  unit        Unit     @relation(fields: [unit_id], references: [id])
  branch_id   Int
  branch      Branch   @relation(fields: [branch_id], references: [id])

  benefit_id  Int          @unique()
  ItemBenifit Benefit      @relation(fields: [benefit_id], references: [id],onDelete: Cascade)
  DonateItem  DonateItem[]

  @@map("item")
}

model BeneficiaryBenefit {
  beneficiary_id Int
  beneficiary    Beneficiary @relation(fields: [beneficiary_id], references: [id])
  benefit_id     Int
  Benefit        Benefit     @relation(fields: [benefit_id], references: [id],onDelete: Cascade)

  item_unit_size UNIT_SIZE? // if not financial benefit
  item_value     Int? // if not financial benefit

  @@id([beneficiary_id, benefit_id])
  @@map("beneficiary_benefit")
}

model VisitBenefit {
  id Int @id @default(autoincrement())

  visit_id   Int
  visit      Visit   @relation(fields: [visit_id], references: [id])
  benefit_id Int
  Benefit    Benefit @relation(fields: [benefit_id], references: [id])

  unit_label_and_unit String
  unit_value          Decimal
  Transaction         Transaction?

  @@map("visit_benefit")
}

model Visit {
  id             Int            @id @default(autoincrement())
  beneficiary_id Int
  created_at     DateTime
  note           String?        @db.Text
  visit_benefits VisitBenefit[]
  branch_id      Int
  branch         Branch         @relation(fields: [branch_id], references: [id])

  @@map("visit")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  Item Item[]

  parent_category_id Int?
  parentCategory     Category?  @relation("CategoryHierarchy", fields: [parent_category_id], references: [id])
  categories         Category[] @relation("CategoryHierarchy")

  branch_id Int
  branch    Branch @relation(fields: [branch_id], references: [id])

  @@map("category")
}

model MoneyUnit {
  id      Int    @id @default(autoincrement())
  en_code String
  en_name String

  ar_code          String
  ar_name          String
  Transaction      Transaction[]
  FinancialBenefit FinancialBenefit[]

  @@map("money_unit")
}

model Unit {
  id              Int    @id @default(autoincrement())
  category_label  String
  label           String @unique()
  bg_unit_label   String
  bg_unit_abbr    String
  sm_unit_label   String
  sm_unit_abbr    String
  sm_to_bg_factor Int
  item            Item[]

  @@map("unit")
}

model SponsorshipCase {
  id        Int      @id @default(autoincrement()) @db.TinyInt
  name      String
  branch_id Int
  branch    Branch   @relation(fields: [branch_id], references: [id])
  persons   Person[]

  @@map("sponsorship_case")
}

model Organization {
  id         Int       @id @default(autoincrement())
  name       String
  created_at DateTime?
  logo_url   String?
  branches   Branch[]

  @@map("organization")
}

model Branch {
  id                 Int               @id @default(autoincrement())
  address            String?
  phone              String?
  name               String
  organization_id    Int
  scheduled_visits   Boolean           @default(false)
  Organization       Organization      @relation(fields: [organization_id], references: [id])
  lang               Lang
  beneficiaries      Beneficiary[]
  sponsorships_cases SponsorshipCase[]
  Visit              Visit[]
  Donate             Donate[]
  Transaction        Transaction[]
  CategoryItem       Category[]
  Item               Item[]

  users BranchUser[]

  @@map("branch")
}

model User {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  password     String
  is_suspended Boolean @default(false)
  lang         Lang
  role_id      Int?
  role         Role?   @relation(fields: [role_id], references: [id])
  notes        Note[]

  branches BranchUser[]

  @@map("user")
}

model BranchUser {
  branch_id Int
  user_id   Int

  Branch Branch @relation(fields: [branch_id], references: [id])
  User   User   @relation(fields: [user_id], references: [id])

  @@id([branch_id, user_id])
  @@map("branch_user")
}

model Donate {
  id          Int      @id @default(autoincrement())
  donor       String
  donor_phone String?
  created_at  DateTime @default(now())
  created_by  String

  branch_id    Int
  branch       Branch       @relation(fields: [branch_id], references: [id])
  transaction  Transaction?
  donate_items DonateItem[]

  @@map("donate")
}

model DonateItem {
  id              Int       @id @default(autoincrement())
  item_id         Int
  donate_id       Int
  unit_value      Int // The  stored small value
  user_unit_size  UNIT_SIZE // the unit that user select when he add item
  user_unit_value Int // the value that user typed when add item

  Donate Donate @relation(fields: [donate_id], references: [id], onDelete: Cascade)
  Item   Item   @relation(fields: [item_id], references: [id])

  @@map("donate_item")
}

model Transaction {
  id         Int             @id @default(autoincrement())
  created_at DateTime        @default(now())
  created_by String
  unit_id    Int
  amount     Decimal         @db.Decimal(10, 2)
  label      String?
  type       TransactionType

  Unit MoneyUnit @relation(fields: [unit_id], references: [id])

  branch_id Int
  branch    Branch @relation(fields: [branch_id], references: [id])

  donate_id          Int?          @unique
  donate             Donate?       @relation(fields: [donate_id], references: [id], onDelete: Cascade)
  visit_benefit_id   Int?          @unique
  visit_benefit_item VisitBenefit? @relation(fields: [visit_benefit_id], references: [id])

  @@map("transaction")
}

model Role {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  /// [RolePermissions]
  permissions Json
  users       User[]

  @@map("role")
}

model Note {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  content       String
  branch_id  Int?

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  @@map("note")
}

enum Lang {
  ar
  en
}

enum TransactionType {
  DONATE
  EXPENSE
}

enum UNIT_SIZE {
  SM
  LG
}

enum GENDER {
  MALE
  FEMALE
}

enum PersonType {
  BENEFICIARY
  SPOUSE
  CHILD
}

enum BenefitType {
  FINANCIAL
  ITEM
}
